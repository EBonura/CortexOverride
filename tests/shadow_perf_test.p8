pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

-- shadow perf test
-- mouse controls light
-- x: run validation test

function _init()
  palt(0,false)
  palt(14,true)
  poke(0x5f2d,1)
  init_light_tables()
  fset(1,0,true)
  lx,ly=64,64
end

function _update()
  lx,ly=stat(32),stat(33)
  if btnp(4) then run_test() end
end

function _draw()
  cls()
  map(0,0,0,0,16,16)
  local rad=50
  _lx,_ly,_lr2=lx,ly,rad*rad

  draw_light(lx,ly,rad)
  shadow_poly_merged(lx,ly,rad)

  circfill(lx,ly,2,7)
  camera()
  rectfill(0,0,127,9,0)
  print("cpu:"..stat(1),1,2,7)
end

----------------------------
-- lighting core
----------------------------
function init_light_tables()
  local dark={0,1,1,1,1,0,5,6,2,5,9,3,1,2,2,4}
  for i=0,15 do
    for j=0,15 do
      poke(0x4300+bor(shl(i,4),j),bor(shl(dark[i+1],4),dark[j+1]))
    end
  end
end

function draw_light(lx,ly,rad)
  local r2=rad*rad
  local ty,by=max(0,flr(ly-rad)),min(127,flr(ly+rad))
  for y=0,ty do dk_line(y,0,0) end
  for y=by,127 do dk_line(y,0,0) end
  for y=ty+1,by-1 do
    local dy=ly-y
    local dx=sqrt(r2-dy*dy)
    dk_line(y,max(0,lx-dx),min(127,lx+dx))
  end
end

function dk_line(y,sx,ex)
  local row=0x6000+y*64
  for i=0,sx\2 do poke(row+i,@(0x4300+@(row+i))) end
  for i=ex\2,63 do poke(row+i,@(0x4300+@(row+i))) end
end

function dk_span(y,x1,x2)
  if x1>x2 then return end
  local row=0x6000+y*64
  for i=x1\2,x2\2 do
    poke(row+i,@(0x4300+@(row+i)))
  end
end

----------------------------
-- shadow: merged edges
----------------------------
function shadow_poly_merged(lx,ly,rad)
  local px,py=lx+cam_x,ly+cam_y
  local t1,t2=max(0,flr((py-rad)/8)),min(15,flr((py+rad)/8))
  local x1,x2=max(0,flr((px-rad)/8)),min(15,flr((px+rad)/8))
  local _fg,_mg=fget,mget
  local function w(tx,ty)
    return tx>=0 and tx<=15 and ty>=0 and ty<=15 and _fg(_mg(tx,ty),0)
  end

  for ty=t1,t2 do
    local rs=nil
    for tx=x1,x2+1 do
      if tx<=x2 and w(tx,ty) and not w(tx,ty-1) then
        if not rs then rs=tx end
      else
        if rs then opt_edge(lx,ly,rs*8,ty*8,tx*8,ty*8,rad) rs=nil end
      end
    end
  end

  for ty=t1,t2 do
    local rs=nil
    for tx=x1,x2+1 do
      if tx<=x2 and w(tx,ty) and not w(tx,ty+1) then
        if not rs then rs=tx end
      else
        if rs then opt_edge(lx,ly,tx*8,(ty+1)*8,rs*8,(ty+1)*8,rad) rs=nil end
      end
    end
  end

  for tx=x1,x2 do
    local rs=nil
    for ty=t1,t2+1 do
      if ty<=t2 and w(tx,ty) and not w(tx+1,ty) then
        if not rs then rs=ty end
      else
        if rs then opt_edge(lx,ly,(tx+1)*8,rs*8,(tx+1)*8,ty*8,rad) rs=nil end
      end
    end
  end

  for tx=x1,x2 do
    local rs=nil
    for ty=t1,t2+1 do
      if ty<=t2 and w(tx,ty) and not w(tx-1,ty) then
        if not rs then rs=ty end
      else
        if rs then opt_edge(lx,ly,tx*8,ty*8,tx*8,rs*8,rad) rs=nil end
      end
    end
  end
end

function opt_edge(lx,ly,x1,y1,x2,y2,rad)
  local mx,my=(x1+x2)/2,(y1+y2)/2
  local nx,ny=-(y2-y1),(x2-x1)
  if nx*(lx-mx)+ny*(ly-my)<=0 then return end
  local d1x,d1y=x1-lx,y1-ly
  local d2x,d2y=x2-lx,y2-ly
  local len1=max(1,max(abs(d1x),abs(d1y)))
  local len2=max(1,max(abs(d2x),abs(d2y)))
  local ext=rad*2
  fill_quad(x1,y1,x2,y2,
    lx+d2x/len2*ext,ly+d2y/len2*ext,
    lx+d1x/len1*ext,ly+d1y/len1*ext)
end

function fill_quad(x1,y1,x2,y2,x3,y3,x4,y4)
  local miny=max(0,flr(min(min(y1,y2),min(y3,y4))))
  local maxy=min(127,flr(max(max(y1,y2),max(y3,y4))))
  local edges={
    {y1,y2,x1,x2},{y2,y3,x2,x3},
    {y3,y4,x3,x4},{y4,y1,x4,x1}
  }
  for y=miny,maxy do
    local dy=_ly-y
    local d2=dy*dy
    local cl,cr=1,0
    if d2<_lr2 then
      local cdx=sqrt(_lr2-d2)
      local rl=max(0,_lx-cdx)
      local rr=min(127,_lx+cdx)
      cl=(flr(rl/2)+1)*2
      cr=flr((rr+1)/2)*2-1
    end
    if cl<=cr then
      local xn,xx=127,0
      for e in all(edges) do
        local ey1,ey2,ex1,ex2=e[1],e[2],e[3],e[4]
        if (y-ey1)*(y-ey2)<=0 and ey1~=ey2 then
          local x=ex1+(ex2-ex1)*(y-ey1)/(ey2-ey1)
          if x<xn then xn=x end
          if x>xx then xx=x end
        end
      end
      if xn<=xx then
        dk_span(y,max(cl,flr(xn)),min(cr,flr(xx)))
      end
    end
  end
end

----------------------------
-- validation test
----------------------------
function run_test()
  local tlx,tly,trad=64,64,50

  rectfill(0,0,127,127,7)
  for ty=0,15 do
    for tx=0,15 do
      if fget(mget(tx,ty),0) then
        spr(1,tx*8,ty*8)
      end
    end
  end

  _lx,_ly,_lr2=tlx,tly,trad*trad
  draw_light(tlx,tly,trad)
  shadow_poly_merged(tlx,tly,trad)

  local counts={}
  for i=0,15 do counts[i]=0 end

  for y=0,127 do
    for x=0,127 do
      local mx,my=flr(x/8),flr(y/8)
      if not fget(mget(mx,my),0) then
        local c=pget(x,y)
        counts[c]+=1
      end
    end
  end

  local n7,n6,n5=counts[7],counts[6],counts[5]
  local nbad=0
  local bad_c={}
  for i=0,15 do
    if i~=7 and i~=6 and i~=5 and counts[i]>0 then
      nbad+=counts[i]
      bad_c[i]=counts[i]
    end
  end
  local pass=n5==0 and nbad==0
  local tag=pass and "ok" or "FAIL"
  printh("["..tag.."] lit:"..n7.." shd:"..n6.." dbl:"..n5.." bad:"..nbad)
  for c,cnt in pairs(bad_c) do
    printh("  bad color "..c..": "..cnt.."px")
  end
end

cam_x,cam_y=0,0

